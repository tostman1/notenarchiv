# Advanced deployment only. For the standard first install use configuration.yaml
# and docs/INSTALL.de.md; no .env file is needed there.
# Synology technical preview. Examples only; never use actual archive roots yet.
# Copy to .env beside compose.yaml. Use unquoted, canonical absolute host paths.
# Fill in the published digest and real non-root numeric service identity.
APP_IMAGE=ghcr.io/tostman1/notenarchiv@sha256:REPLACE_WITH_PUBLISHED_DIGEST
APP_UID=
APP_GID=
APP_BIND=127.0.0.1
APP_PORT=8085
TZ=Europe/Vienna
PREVIEW_DATA_ONLY=TRUE

APP_ALLOWED_HOSTS=notenarchiv.example.invalid,localhost,127.0.0.1
APP_CSRF_TRUSTED_ORIGINS=https://notenarchiv.example.invalid

# Separate EMPTY or SYNTHETIC roots. RAW must also be read-only in DSM ACLs.
SOURCE_HOST=/volume1/notenarchiv-preview/raw
CURATED_HOST=/volume1/notenarchiv-preview/clean
PROCESSED_HOST=/volume1/notenarchiv-preview/processed
STATUS_HOST=/volume1/notenarchiv-preview/status
EXPORT_HOST=/volume1/notenarchiv-preview/export
DATA_HOST=/volume1/docker/notenarchiv-preview/data
SECRET_HOST=/volume1/docker/notenarchiv-preview/secrets/django_secret_key

# Container paths, NAS profile and PRINT_ENABLED=0 are fixed by compose.yaml.
# No secret contents belong here. Mount a protected secret file instead.
# DEBUG_MODE is absent by default. Add compose.debug.yaml to enable diagnostics.
