# Notenarchiv deployment environment (example only — no real secrets).
# Copy to .env on the NAS and fill in actual values. .env is git-ignored.
# All variables are consumed by config/env.py; see ARCHITECTURE.md section 9.1.

# --- Identity and binding -------------------------------------------------
# APP_IMAGE=ghcr.io/<owner>/notenarchiv:<approved-tag>   # set in compose, not here
# APP_UID=          # numeric, from: id -u svc_notenarchiv
# APP_GID=          # numeric, from: id -g svc_notenarchiv
APP_BIND=127.0.0.1
APP_PORT=8085
TZ=Europe/Vienna

# --- Host allowlist (required in the nas profile) --------------------------
APP_ALLOWED_HOSTS=notenarchiv.example.invalid,localhost,127.0.0.1
APP_CSRF_TRUSTED_ORIGINS=https://notenarchiv.example.invalid

# --- Secret (protected file, not secret contents) ---------------------------
DJANGO_SECRET_KEY_FILE=/volume1/docker/notenarchiv/secrets/django_secret_key

# --- Database --------------------------------------------------------------
DATABASE_PATH=/volume1/docker/notenarchiv/data/notenarchiv.sqlite3

# --- Archive roots (container-internal paths; host paths mapped in compose) --
SOURCE_DIR=/archive/raw
CURATED_DIR=/archive/clean
PROCESSED_DIR=/archive/processed
STATUS_DIR=/archive/status
EXPORT_DIR=/archive/export

# --- Application mode (OP-04; shared by web and worker) ---------------------
# Absent or FALSE = Deploy (default). TRUE = application diagnostics.
# Recreate both services after changing; Django DEBUG stays False always.
# DEBUG_MODE=FALSE

# --- Processing limits (defaults shown; adjust after measurements) ----------
# OCR_LANGUAGES=deu+eng
# OCR_DPI=300
# OCR_TIMEOUT_SECONDS=60
# OCR_WORKERS=1
# OMP_THREAD_LIMIT=2
# PDF_MAX_BYTES=104857600
# PDF_MAX_RENDER_PIXELS=30000000

# --- Feature flags ----------------------------------------------------------
# PRINT_ENABLED=0
